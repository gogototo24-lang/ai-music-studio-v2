# AI Music Studio v2 - Environment Configuration

# Server
PORT=8000
MAX_UPLOAD_MB=120
CORS_ORIGINS=https://gogototo24-lang.github.io

# MusicGen (optional)
MUSICGEN_MODEL=facebook/musicgen-small
MUSICGEN_DEVICE=cuda
# MUSICGEN_DEVICE options:
#   cuda - NVIDIA GPU (requires torch with CUDA support)
#   cpu  - CPU mode (slower but works everywhere)
#   auto - Auto-detect (default behavior)

# Mode selection
# MODE=lite    # FFmpeg + Edge TTS only
# MODE=ai      # Full AI features (MusicGen + Demucs)


# Voice routing
VOICE_PRIMARY_PROVIDER=runninghub
VOICE_FALLBACK_ORDER=runninghub,cosyvoice,gpt-sovits,pilottts,edge

# RunningHub GPU voice workflow
# Use a copied/forked voice-clone workflow in your own RunningHub workspace.
RUNNINGHUB_API_KEY=
RUNNINGHUB_VOICE_WORKFLOW_ID=
RUNNINGHUB_TEXT_NODE_ID=
RUNNINGHUB_TEXT_FIELD=text
RUNNINGHUB_POLL_SECONDS=5
RUNNINGHUB_MAX_WAIT_SECONDS=180
RUNNINGHUB_BASE_URL=https://www.runninghub.ai

# Optional self-hosted providers
COSYVOICE_API_URL=
PILOTTTS_API_URL=
GPT_SOVITS_API_URL=
