# AI Music Studio v2 - Environment Configuration

# Server
PORT=8000
MAX_UPLOAD_MB=120
CORS_ORIGINS=https://gogototo24-lang.github.io

# MusicGen (optional)
MUSICGEN_MODEL=facebook/musicgen-small
MUSICGEN_DEVICE=cuda
# MUSICGEN_DEVICE options:
#   cuda - NVIDIA GPU (requires torch with CUDA support)
#   cpu  - CPU mode (slower but works everywhere)
#   auto - Auto-detect (default behavior)

# Mode selection
# MODE=lite    # FFmpeg + Edge TTS only
# MODE=ai      # Full AI features (MusicGen + Demucs)
